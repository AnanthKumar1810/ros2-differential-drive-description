<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">
  <!-- Dimensions are in metres; joint angles are in radians. -->
  <xacro:property name="base_length" value="0.6"/>
  <xacro:property name="base_width" value="0.4"/>
  <xacro:property name="base_height" value="0.2"/>
  <xacro:property name="wheel_radius" value="0.1"/>
  <xacro:property name="wheel_width" value="0.05"/>
  <xacro:property name="wheel_y" value="${(base_width + wheel_width) / 2}"/>
  <xacro:property name="caster_radius" value="0.06"/>
  <xacro:property name="laser_radius" value="0.07"/>
  <xacro:property name="laser_height" value="0.05"/>

  <material name="chassis_blue"><color rgba="0.15 0.4 0.75 1"/></material>
  <material name="wheel_dark"><color rgba="0.12 0.12 0.12 1"/></material>
  <material name="sensor_red"><color rgba="0.8 0.2 0.15 1"/></material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="chassis_blue"/>
    </visual>
  </link>

  <xacro:macro name="wheel" params="name y_position">
    <link name="${name}_wheel_link">
      <visual>
        <!-- URDF cylinders point along Z; rotate geometry onto the Y axle. -->
        <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_dark"/>
      </visual>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <origin xyz="0 ${y_position} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <xacro:wheel name="left" y_position="${wheel_y}"/>
  <xacro:wheel name="right" y_position="${-wheel_y}"/>

  <link name="caster_link">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="wheel_dark"/>
    </visual>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="-0.22 0 -0.12" rpy="0 0 0"/>
  </joint>

  <link name="laser_link">
    <visual>
      <geometry><cylinder radius="${laser_radius}" length="${laser_height}"/></geometry>
      <material name="sensor_red"/>
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.10 0 0.15" rpy="0 0 0"/>
  </joint>
</robot>

